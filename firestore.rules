rules_version = '2';

// Nipper Hub — Firestore security rules
// - Only approved staff (role 'admin' or 'age_manager') can read/write nipper data.
// - The FIRST person to sign in claims the club and becomes admin
//   (by creating meta/owner in the same batch as their staff doc).
// - Everyone else signs up as 'pending' until an admin approves them.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function staffPath() { return /databases/$(database)/documents/staff/$(request.auth.uid); }
    function role() { return get(staffPath()).data.role; }
    function isStaff() { return signedIn() && exists(staffPath()) && role() in ['admin', 'age_manager']; }
    function isAdmin() { return signedIn() && exists(staffPath()) && role() == 'admin'; }

    match /meta/owner {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /staff/{uid} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid && (
        request.resource.data.role == 'pending' ||
        (request.resource.data.role == 'admin'
          && !exists(/databases/$(database)/documents/meta/owner)
          && getAfter(/databases/$(database)/documents/meta/owner).data.uid == request.auth.uid)
      );
      // Admins can change anyone's role; people can edit their own name but not their role.
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /participants/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /sessions/{id} {
      allow read, create, update, delete: if isStaff();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
