rules_version = '2';

// Nipper Hub — Firestore security rules (login-code version)
//
// - Staff sign in with a login code. Each code is a Firebase Auth account
//   with a matching staff/{uid} document that says what role it has.
// - Only active staff (role 'admin' or 'age_manager') can read/write nipper data.
//   Setting a code to 'removed' (Deactivate on the Admin page) cuts access instantly.
// - Only admins can create codes, see codes, or change roles.
// - First-time setup: the very first admin code can claim the club by creating
//   meta/owner in the same batch. Once meta/owner exists, that door is closed.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function staffPath() { return /databases/$(database)/documents/staff/$(request.auth.uid); }
    function ownerPath() { return /databases/$(database)/documents/meta/owner; }
    function role() { return get(staffPath()).data.role; }
    function isStaff() { return signedIn() && exists(staffPath()) && role() in ['admin', 'age_manager']; }
    function isAdmin() { return signedIn() && exists(staffPath()) && role() == 'admin'; }
    // True only inside the first-time-setup batch, for the person claiming the club.
    function isClaimingOwner() {
      return signedIn() && !exists(ownerPath()) && getAfter(ownerPath()).data.uid == request.auth.uid;
    }

    match /meta/owner {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /staff/{uid} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin()
        || (request.auth.uid == uid && isClaimingOwner() && request.resource.data.role == 'admin');
      // Admins can change anyone. Staff can update their own record (name, last
      // sign-in) but can never change their own role.
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // The login codes themselves — admins only.
    match /codes/{uid} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (request.auth.uid == uid && isClaimingOwner());
    }

    match /participants/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /sessions/{id} {
      allow read, create, update, delete: if isStaff();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
