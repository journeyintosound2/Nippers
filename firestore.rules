rules_version = '2';

// Nipper Hub — Firestore security rules (single club code)
//
// Everyone signs in with the same club code, which is one Firebase Auth
// account. Only that account (recorded in meta/owner during first-time
// setup) can read or write nipper data. Anyone else, including someone who
// makes their own Firebase account, is locked out.
service cloud.firestore {
  match /databases/{database}/documents {

    function ownerPath() { return /databases/$(database)/documents/meta/owner; }
    function isClub() {
      return request.auth != null && exists(ownerPath()) && get(ownerPath()).data.uid == request.auth.uid;
    }

    // First-time setup claims the database once. After that it can't be changed.
    match /meta/owner {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /participants/{id} {
      allow read, write: if isClub();
    }

    match /sessions/{id} {
      allow read, write: if isClub();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
